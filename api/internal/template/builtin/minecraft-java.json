{
  "id": "minecraft-java",
  "name": "Minecraft (Java)",
  "category": "games",
  "short": "MC",
  "image": "itzg/minecraft-server:java21",
  "ports": [
    {
      "container": 25565,
      "protocol": "tcp",
      "label": "game"
    }
  ],
  "volumes": [
    {
      "container": "/data"
    }
  ],
  "defaultMemory": "4g",
  "minMemory": "2g",
  "defaultCpus": 2,
  "stopGraceSeconds": 120,
  "fields": [
    {
      "key": "EULA",
      "label": "EULA da Mojang",
      "type": "bool",
      "default": "true",
      "required": true,
      "help": "The image does not start unless this is accepted."
    },
    {
      "key": "TYPE",
      "label": "Distribution",
      "type": "enum",
      "default": "VANILLA",
      "options": [
        {
          "value": "VANILLA",
          "label": "Vanilla"
        },
        {
          "value": "PAPER",
          "label": "Paper"
        },
        {
          "value": "FABRIC",
          "label": "Fabric"
        },
        {
          "value": "FORGE",
          "label": "Forge"
        },
        {
          "value": "SPIGOT",
          "label": "Spigot"
        }
      ]
    },
    {
      "key": "VERSION",
      "label": "Version",
      "type": "text",
      "default": "LATEST",
      "help": "LATEST, SNAPSHOT or an exact version such as 1.21.1."
    },
    {
      "key": "MEMORY",
      "label": "Heap da JVM",
      "type": "text",
      "default": "3G",
      "help": "Keep it at least 1 GB below the container RAM limit, or the kernel kills the process (exit 137)."
    },
    {
      "key": "MOTD",
      "label": "MOTD",
      "type": "text",
      "default": "Servidor OkDock"
    },
    {
      "key": "DIFFICULTY",
      "label": "Dificuldade",
      "type": "enum",
      "default": "normal",
      "options": [
        {
          "value": "peaceful",
          "label": "Peaceful"
        },
        {
          "value": "easy",
          "label": "Easy"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "hard",
          "label": "Hard"
        }
      ]
    },
    {
      "key": "MODE",
      "label": "Game mode",
      "type": "enum",
      "default": "survival",
      "options": [
        {
          "value": "survival",
          "label": "Survival"
        },
        {
          "value": "creative",
          "label": "Creative"
        },
        {
          "value": "adventure",
          "label": "Adventure"
        },
        {
          "value": "spectator",
          "label": "Spectator"
        }
      ]
    },
    {
      "key": "MAX_PLAYERS",
      "label": "Max players",
      "type": "int",
      "default": "10",
      "min": 1,
      "max": 200
    },
    {
      "key": "ONLINE_MODE",
      "label": "Exigir conta Mojang",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "PVP",
      "label": "PvP",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "OPS",
      "label": "Operadores",
      "type": "text",
      "help": "Nicknames separated by commas."
    },
    {
      "key": "LEVEL_SEED",
      "label": "Seed do mundo",
      "type": "text",
      "advanced": true
    },
    {
      "key": "VIEW_DISTANCE",
      "label": "Render distance",
      "type": "int",
      "default": "10",
      "min": 3,
      "max": 32,
      "advanced": true
    },
    {
      "key": "ENABLE_ROLLING_LOGS",
      "label": "Rotacionar logs",
      "type": "bool",
      "default": "true",
      "advanced": true
    }
  ]
}
